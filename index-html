<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>Dekpboy | Medical Roadmap</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@200;400&display=swap');
        body { background: #050505; color: #D4AF37; font-family: 'Inter', sans-serif; }
        .lux-card { background: linear-gradient(145deg, #0a0a0a, #111); border: 1px solid #222; }
        .icon-svg { stroke: #D4AF37; fill: none; stroke-width: 1.5; }
    </style>
</head>
<body class="p-8">
    <header class="text-center mb-16">
        <h1 class="text-5xl font-['Cinzel'] tracking-tighter mb-4">DEKPBOY</h1>
        <div id="quote-box" class="max-w-md mx-auto p-6 border-b border-t border-[#333] text-sm italic text-gray-400">
            "กำลังปลูกฝังความสำเร็จ..."
        </div>
    </header>

    <main class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
        <!-- ตารางเรียน -->
        <div class="lux-card p-8 rounded-sm">
            <h2 class="text-lg uppercase tracking-widest mb-6">Daily Routine</h2>
            <div class="space-y-6">
                <div class="flex items-center gap-4">
                    <svg width="40" height="40" class="icon-svg"><circle cx="20" cy="20" r="15"/><path d="M20 10v10l5 5"/></svg>
                    <div><p class="text-white">05:00 - 06:55</p><p class="text-xs opacity-60">High-Focus Calculation</p></div>
                </div>
            </div>
        </div>

        <!-- วิวัฒนาการต้นไม้ -->
        <div class="lux-card p-8 rounded-sm text-center">
            <h2 class="text-lg uppercase tracking-widest mb-6">Growth Progress</h2>
            <!-- Custom SVG Tree -->
            <svg width="100" height="100" viewBox="0 0 100 100" class="mx-auto icon-svg">
                <path d="M50 90 Q50 50 50 10 M50 30 L30 20 M50 40 L70 30" />
                <circle cx="50" cy="10" r="5" />
            </svg>
            <p class="text-[10px] mt-4 opacity-50">ต้นไม้แห่งวิชาการ 10 ชนิดกำลังเติบโต</p>
        </div>
    </main>

    <script>
        const quotes = ["วินัยคือมงกุฎของผู้กล้า", "ความรู้คืออาวุธที่สง่างามที่สุด", "แพทย์ที่ดีเริ่มจากการเรียนรู้อย่างประณีต"];
        function updateQuote() {
            const index = Math.floor((Date.now() / 600000) % quotes.length);
            document.getElementById('quote-box').innerText = `"${quotes[index]}"`;
        }
        updateQuote();
        setInterval(updateQuote, 60000);
    </script>
</body>
</html>
